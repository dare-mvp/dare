{
  "expo": {
    "name": "DARE",
    "slug": "dare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dare",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050509"
    },
    "ios": {
      "bundleIdentifier": "com.dareapp.mobile",
      "supportsTablet": true,
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050509",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.dareapp.mobile",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ca7ed87b-0965-4a77-9781-f6a4b9fbdab8"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          },
          "ios": {
            "enableMultitaskingCameraAccess": false
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-notifications",
        {
          "color": "#FF5500",
          "icon": "./assets/notification-icon.png",
          "defaultChannel": "dare-alerts"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DARE to use your camera to capture proof inside a challenge.",
          "microphonePermission": "Allow DARE to use your microphone when recording video evidence.",
          "recordAudioAndroid": true
        }
      ],
      "expo-secure-store"
    ],
    "owner": "dare-mobile-organization"
  }
}
